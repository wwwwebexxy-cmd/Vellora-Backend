# Copy to .env for local development. Never commit the real .env file.
VELLORA_DEBUG=True
VELLORA_SECRET_KEY=generate-a-50-plus-character-random-secret-with-many-character-types
VELLORA_ALLOWED_HOSTS=localhost,127.0.0.1
VELLORA_DEPLOYMENT_ALLOWED_HOSTS=localhost,127.0.0.1
VELLORA_SITE_URL=http://localhost:5173
# Production: exact browser storefront origins only (comma separated); do not
# use * when requests include cookies.
VELLORA_STOREFRONT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VELLORA_JWT_COOKIE_SAMESITE=Lax
VELLORA_TRUST_PROXY_SSL_HEADER=True

# Production only: Memcached must be reachable by every application worker.
VELLORA_MEMCACHED_LOCATION=127.0.0.1:11211

# These are intentionally new, local-only database settings. Create the
# database and credentials separately for this project; never reuse another
# project's database or password.
VELLORA_DB_NAME=vellora_local
VELLORA_DB_USER=vellora_local_user
VELLORA_DB_PASSWORD=replace_with_a_new_local_password
VELLORA_DB_HOST=127.0.0.1
VELLORA_DB_PORT=3306

VELLORA_GOOGLE_CLIENT_ID=your-google-oauth-client-id
# Google OAuth and SMTP are separate credentials. For a temporary Mailtrap
# Email Sandbox setup, uncomment EMAIL_PROVIDER and fill in the credentials
# shown in Mailtrap. For Mailtrap Email Sending, use that domain's SMTP host.
# Never commit SMTP passwords to the repository.
VELLORA_EMAIL_PROVIDER=smtp
# VELLORA_EMAIL_PROVIDER=mailtrap
# VELLORA_MAILTRAP_SMTP_HOST=sandbox.smtp.mailtrap.io
# VELLORA_MAILTRAP_SMTP_PORT=2525
# VELLORA_MAILTRAP_SMTP_USERNAME=your-mailtrap-username
# VELLORA_MAILTRAP_SMTP_PASSWORD=your-mailtrap-password
# VELLORA_MAILTRAP_FROM_EMAIL=no-reply@vellora.test
VELLORA_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
VELLORA_EMAIL_HOST=smtp.gmail.com
VELLORA_EMAIL_PORT=587
VELLORA_EMAIL_USE_TLS=True
VELLORA_EMAIL_USE_SSL=False
VELLORA_EMAIL_HOST_USER=your-new-sender@example.com
VELLORA_EMAIL_HOST_PASSWORD=your-gmail-app-password
VELLORA_DEFAULT_FROM_EMAIL=no-reply@vellora.example
VELLORA_ORDER_NOTIFICATION_EMAIL=owner@example.com
VELLORA_EMAIL_TIMEOUT=20
VELLORA_PASSWORD_RESET_TIMEOUT=3600
# Cashfree Payments. Keep these values on the backend only.
VELLORA_CASHFREE_ENV=sandbox
VELLORA_CASHFREE_CLIENT_ID=app_id_replace_me
VELLORA_CASHFREE_CLIENT_SECRET=secret_key_replace_me
# Cashfree order currency for the current storefront/test configuration.
VELLORA_CASHFREE_ORDER_CURRENCY=INR
# Add the new project's webhook URL only after its new domain is created.
VELLORA_CASHFREE_WEBHOOK_URL=
